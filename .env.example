# 預設只產出報告；只有 --send-email 才會寄信。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=unfinished360.podcast@gmail.com

# 選填：合法、可公開存取的 RSS/Atom；不提供時 Reuters 使用公開科技索引。
REUTERS_FEED_URL=
DIGITIMES_FEED_URL=https://www.digitimes.com/rss/daily.xml

# 選填：啟用公開摘要的 AI 編輯整理；無 key 僅產出素材索引，不寄信。
OPENAI_API_KEY=
OPENAI_EDITOR_MODEL=gpt-4.1-mini
